{
  "ConnectionStrings": {
    "Default": "Data Source=martpos.db"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/pos-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "POS": {
    "TaxPercent": 17,
    "InvoicePrefix": "INV",
    "CompanyName": "Demo Mart"
  }
}
